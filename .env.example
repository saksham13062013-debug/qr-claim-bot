# Application
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_SECRET=change-me-to-another-long-random-string-32chars
CSRF_SECRET=change-me-to-yet-another-long-random-string32

# Server (Railway sets PORT automatically)
HOST=0.0.0.0
PORT=8000

# Database – use Railway PostgreSQL or external
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/qrclaim

# Telegram Bot (from @BotFather)
BOT_TOKEN=123456:ABC-DEF...
BOT_USERNAME=YourBotUsername
OWNER_TELEGRAM_ID=123456789

# Initial Owner admin (created on first boot)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-strong-password

# Defaults
DEFAULT_REWARD_USD=0.50
MIN_WITHDRAWAL_USD=5
MAX_WITHDRAWAL_USD=1000
FORCE_JOIN_ENABLED=true
CLAIM_APPROVAL_REQUIRED=true
QR_DEFAULT_EXPIRY_HOURS=72
MAINTENANCE_MODE=false
BOT_WELCOME_MESSAGE=🎁 Welcome to QR Claim Bot!\n\nClaim one-time QR rewards, track your balance and request withdrawals.
