# Attach Railway PostgreSQL and copy DATABASE_URL automatically if using the reference variable.
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-long-random-password
OWNER_TELEGRAM_ID=123456789
BOT_TOKEN=123456789:replace-me
BOT_INTERNAL_KEY=replace-with-a-random-internal-key
API_URL=https://YOUR-API-DOMAIN.up.railway.app
API_PORT=4000
MIN_WITHDRAWAL_USD=5
MAX_WITHDRAWAL_USD=1000
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://YOUR-API-DOMAIN.up.railway.app
